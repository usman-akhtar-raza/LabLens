{
  "name": "lablens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "corpus:build": "node --experimental-strip-types scripts/build-corpus.mts",
    "db:verify": "node --experimental-strip-types scripts/verify-supabase.mts",
    "corpus:ingest": "node --experimental-strip-types scripts/ingest-corpus.mts",
    "rag:search": "node --experimental-strip-types scripts/search-corpus.mts",
    "rag:check": "node --experimental-strip-types scripts/check-retrieval.mts",
    "rag:compare-search": "node --experimental-strip-types scripts/compare-passage-search.mts",
    "rag:check-answers": "node --experimental-strip-types scripts/check-answers.mts",
    "test:rag": "node --experimental-strip-types --test src/lib/rag/*.test.mts",
    "reference:ingest": "node --experimental-strip-types scripts/ingest-reference.mts",
    "reference:check": "node --experimental-strip-types scripts/check-ingested-reference.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "openai": "^7.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
